# ==========================================
# LuthuliScents Environment Variables
# ==========================================

# 1. Yoco Payments
# Get your secret key from: Yoco Dashboard -> Settings -> API Keys (sk_live_... or sk_test_...)
YOCO_SECRET_KEY=sk_live_your_yoco_secret_key_here

# 2. The Courier Guy (ShipLogic API)
# Get your API key from: The Courier Guy portal (https://tcg.shiplogic.com -> Settings -> API keys)
COURIER_GUY_API_KEY=your_tcg_api_key_here
COURIER_GUY_BASE_URL=https://api.shiplogic.com

# Optional Courier Guy account ID (if required by your account profile)
# COURIER_GUY_ACCOUNT_ID=

# 3. Collection (Pickup) Address & Contact Information
# JSON formatted address of your pickup location
COURIER_GUY_COLLECTION_ADDRESS={"company":"LuthuliScents","street_address":"46 Loveday Street, Trump Center Building, Wemmer","local_area":"Selby","city":"Johannesburg","zone":"Gauteng","country":"ZA","code":"2092"}
COURIER_GUY_COLLECTION_NAME=LuthuliScents
COURIER_GUY_COLLECTION_PHONE=+27692380796
COURIER_GUY_COLLECTION_EMAIL=sthandiweluthuli322@gmail.com